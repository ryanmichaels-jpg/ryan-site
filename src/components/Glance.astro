---
/**
 * The "at a glance" block — numbers doing the arguing.
 *   <Glance items={[{ n: '15', label: 'personas run adversarially' }, …]} />
 */
interface Item { n: string; label: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'At a glance' } = Astro.props;
---

<aside class="bleed glance">
  <p class="label glance__title">{title}</p>
  <dl>
    {items.map((i) => (
      <div>
        <dt>{i.n}</dt>
        <dd>{i.label}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .glance {
    margin-block: 3rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-block: 1rem 1.4rem;
  }
  .glance__title { margin: 0 0 1.1rem; }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1.6rem 1.4rem;
  }
  dt {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-variation-settings: 'opsz' 40;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-feature-settings: 'lnum' 1;
  }
  dd {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }
</style>
