---
/**
 * One figure component, two kinds of source.
 *
 *   <Diagram src="junto-system-map.html" caption="…" height={620} />   live HTML, dark plate
 *   <Diagram src="junto-structure.png" caption="…" />                  an image, light plate
 *
 * HTML diagrams live in `public/diagrams/`, images in `public/figures/`.
 * `height` only applies to HTML; images size to their own aspect ratio.
 */
interface Props {
  src: string;
  caption?: string;
  /** Figure number or short label shown above the frame. */
  label?: string;
  height?: number;
  /** Override the alt text. Defaults to the caption. */
  alt?: string;
}
const { src, caption, label, height = 620, alt } = Astro.props;

const isImage = /\.(png|jpe?g|webp|avif|gif|svg)$/i.test(src);
const url = src.startsWith('http')
  ? src
  : isImage
    ? `/figures/${src}`
    : `/diagrams/${src}`;
---

<figure class:list={['bleed', 'diagram', isImage && 'diagram--image']}>
  {label && <p class="label diagram__label">{label}</p>}

  <div class="diagram__frame" style={isImage ? undefined : `--h:${height}px`}>
    {
      isImage ? (
        <img src={url} alt={alt ?? caption ?? label ?? 'Diagram'} loading="lazy" />
      ) : (
        <iframe src={url} title={caption ?? label ?? 'Diagram'} loading="lazy" />
      )
    }
  </div>

  <figcaption>
    {caption && <span>{caption}</span>}
    <a href={url} target="_blank" rel="noopener">Open full ↗</a>
  </figcaption>
</figure>

<style>
  .diagram { margin-block: 3rem; }
  .diagram__label { margin: 0 0 0.55rem; }

  /* Live HTML diagrams bring their own dark styling, so they're mounted like a
     plate set into the page rather than fought with. */
  .diagram__frame {
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #0c0c0e;
    padding: 0.5rem;
    overflow: hidden;
    height: var(--h);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .diagram__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 2px;
    background: transparent;
  }

  /* Hand-drawn figures keep their own light canvas — a light plate set into
     the dark page, never color-inverted. */
  .diagram--image .diagram__frame {
    background: transparent;
    border: 1px solid var(--rule);
    height: auto;
    padding: 0;
    box-shadow: none;
  }
  .diagram--image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 5px;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }
  figcaption a { text-decoration: none; white-space: nowrap; }
  figcaption a:hover { text-decoration: underline; }
</style>
