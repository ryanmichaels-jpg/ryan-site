---
/**
 * A video figure, matching Diagram's plate treatment.
 *
 *   <Video src="strudel-rack-demo.mp4" poster="strudel-rack-poster.jpg"
 *          label="Demo" caption="…" />
 *
 * Video files live in `public/media/`. Never autoplays with sound: a long clip
 * with a bed of noise should wait for the reader to press play. Muted + loop +
 * playsinline so that if they do, it behaves.
 */
interface Props {
  src: string;
  poster?: string;
  label?: string;
  caption?: string;
}
const { src, poster, label, caption } = Astro.props;
const url = src.startsWith('http') ? src : `/media/${src}`;
const posterUrl = poster
  ? poster.startsWith('http') ? poster : `/media/${poster}`
  : undefined;
---

<figure class="bleed video">
  {label && <p class="label video__label">{label}</p>}

  <div class="video__frame">
    <video
      src={url}
      poster={posterUrl}
      controls
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
  </div>

  {(caption || label) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      <a href={url} target="_blank" rel="noopener">Open full ↗</a>
    </figcaption>
  )}
</figure>

<style>
  .video { margin-block: 3rem; }
  .video__label { margin: 0 0 0.55rem; }

  .video__frame {
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #0c0c0e;
    padding: 0.5rem;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .video__frame video {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 2px;
    background: #000;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }
  figcaption a { text-decoration: none; white-space: nowrap; }
  figcaption a:hover { text-decoration: underline; }
</style>
