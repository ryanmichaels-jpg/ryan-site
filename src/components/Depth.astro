---
/**
 * The "toggle" from your blueprint: the ten-minute spine stays on the page,
 * every-little-thing depth folds away underneath it.
 *   <Depth summary="How the merge actually held">…</Depth>
 */
interface Props { summary: string }
const { summary } = Astro.props;
---

<details class="depth">
  <summary>{summary}</summary>
  <div class="depth__body"><slot /></div>
</details>

<style>
  .depth {
    margin-block: 1.6rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.7rem;
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    font-family: var(--mono);
    font-size: 0.73rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  summary::-webkit-details-marker { display: none; }
  summary::before {
    content: '+';
    color: var(--accent);
    font-size: 0.95rem;
    line-height: 1;
    transform: translateY(1px);
  }
  .depth[open] summary::before { content: '−'; }
  summary:hover { color: var(--ink); }
  .depth__body {
    padding-top: 0.9rem;
    font-size: 0.94em;
    color: var(--ink-soft);
  }
  .depth__body > :first-child { margin-top: 0; }
  .depth__body > :last-child { margin-bottom: 0; }
</style>
